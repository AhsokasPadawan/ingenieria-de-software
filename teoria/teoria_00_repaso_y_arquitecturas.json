        {
          "id": "arquitecturas-en-diagramas",
          "titulo": "Arquitecturas en Diagramas",
          "bloques": [
            {
              "tema": "Visión desde arriba",
              "definicion": "Comparamos tres formas distintas de organizar la arquitectura de un sistema en diagramas de cajas y flechas.",
              "layout_conceptos": "escalonada",
              "conceptos": [
                {
                  "nombre": "1. Arquitectura en Capas",
                  "definicion": "Flujo vertical descendente: la presentación depende de negocio y negocio de los datos."
                },
                {
                  "nombre": "2. Arquitectura Hexagonal",
                  "definicion": "El núcleo de dominio queda aislado en el centro; los adaptadores externos implementan sus puertos."
                },
                {
                  "nombre": "3. Entity-Component-System",
                  "definicion": "Datos puros en componentes y lógica desacoplada en sistemas que iteran sobre entidades."
                }
              ],
              "conclusion": "Las tres responden siempre la misma pregunta: ¿Hacia dónde apuntan las dependencias?"
            }
          ],
          "animaciones": null,
          "pseudocodigo": null,
          "codigo": null,
          "analisis_complejidad": null
        },
